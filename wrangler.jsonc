{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-booking",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studio-booking-db",
      "database_id": "e93f2a4c-4019-4093-a2a4-b848d6362321",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "556987025610-nk7nptbkdh40s5r4vljth9on7cmdqnd9.apps.googleusercontent.com",
    "GOOGLE_JWKS_URL": "https://www.googleapis.com/oauth2/v3/certs"
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
